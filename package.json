{
  "name": "@minamorl/gear",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@minamorl/berylx": "github:minamorl/berylx-ts#c6436986ed23ada2710bd31214035324e721ec2a",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "bin": {
    "gear-host": "dist/bin/host.js"
  },
  "description": "An execution machine for TypeScript: Clock, Admission, Executor, Journal, Receipt. Effects are data; the journal is the only truth.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minamorl/gear-ts.git"
  }
}
